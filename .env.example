# ---------------------------------------------------------------------------
# Hass BG Gateway configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Home Assistant (one gateway = one HA) --------------------------------
# Base URL of your Home Assistant, with or without a trailing slash.
BGV_HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens.
BGV_HA_TOKEN=replace-with-a-long-lived-access-token

# Set to false only for a self-signed HTTPS certificate you trust.
BGV_HA_VERIFY_TLS=true

# HTTP timeout for Home Assistant calls, seconds.
BGV_HA_TIMEOUT_S=10

# --- API authentication ----------------------------------------------------
# Empty disables auth. When set, EVERY /v1 request must send:
#   X-API-Key: <value>
# Use a long random value, e.g.  openssl rand -hex 32
BGV_API_KEY=

# --- Speech recognition ----------------------------------------------------
# ONNX threads. 4 is a good default; use physical cores, not hyperthreads.
BGV_ASR_THREADS=4

# Hotword boost for configured device names (higher = stronger bias).
BGV_HOTWORDS_SCORE=3.0

# Silence padding around push-to-talk audio, seconds. The tail must be long
# enough not to cut the last syllable (1.0 works for the bundled model).
BGV_LEAD_SILENCE_S=0.2
BGV_TAIL_SILENCE_S=1.0

# --- Text to speech (only for commands with speak: true) -------------------
BGV_TTS_ENABLED=true

# gtts  = Google Translate female Bulgarian voice (~210 Hz, ~400 ms, internet,
#         answer text leaves the machine).
# piper = local bg_BG-dimitar-medium male voice (~80 ms, offline).
# gTTS falls back to Piper automatically if the network fails.
BGV_TTS_PROVIDER=gtts
BGV_TTS_LANGUAGE=bg
BGV_TTS_TIMEOUT_S=5.0

# --- Paths / logging -------------------------------------------------------
BGV_CONFIG_DIR=config

# Catalogue file inside BGV_CONFIG_DIR. commands.yaml is the minimal starter;
# commands-example.yaml is the full real-home example.
BGV_COMMANDS_FILE=commands.yaml

BGV_MODELS_DIR=models
BGV_LOG_LEVEL=INFO
