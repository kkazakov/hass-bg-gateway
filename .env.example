# Gateway
BGV_API_KEY=
BGV_ASR_THREADS=4
BGV_TTS_ENABLED=true
# gtts = Google female voice (needs internet); piper = local male voice
BGV_TTS_PROVIDER=gtts
BGV_LOG_LEVEL=INFO
# BGV_TAIL_SILENCE_S=1.0
# BGV_LEAD_SILENCE_S=0.2

# Home Assistant long-lived access tokens (one per instance in instances.yaml)
HA_HOME_TOKEN=
